# Local-only development settings. Use a unique secret and managed database in production.
POSTGRES_DB=unimark
POSTGRES_USER=unimark
POSTGRES_PASSWORD=replace-this-local-password
UNIMARK_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
GOOGLE_CLIENT_ID=

# Configure an SMTP provider to deliver account verification and sign-in codes.
UNIMARK_SMTP_HOST=
UNIMARK_SMTP_PORT=587
UNIMARK_SMTP_USERNAME=
UNIMARK_SMTP_PASSWORD=
UNIMARK_SMTP_FROM=
UNIMARK_SMTP_SECURITY=starttls
